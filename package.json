{
  "name": "tabbuilder-pro",
  "displayName": "TabBuilder Develop",
  "description": "Enterprise Project Generator for Visual Studio Code. Generate production-ready projects using official CLIs and best practices — Spring Boot, FastAPI, Laravel, ASP.NET, Next.js and 16 more.",
  "version": "3.2.3",
  "publisher": "wenjin",
  "author": {
    "name": "Meikuto",
    "url": "https://meikuto.dev"
  },
  "license": "MIT",
  "homepage": "https://meikuto.dev",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "tabbuilder",
    "meikuto",
    "scaffold",
    "boilerplate",
    "generator",
    "framework",
    "spring boot",
    "fastapi",
    "laravel",
    "nextjs",
    "dotnet",
    "enterprise",
    "project generator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TzerK-LAST/TabBuilder"
  },
  "bugs": {
    "url": "https://github.com/TzerK-LAST/TabBuilder/issues"
  },
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tabbuilder.createProject",
        "title": "TabBuilder: Create New Project",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tabbuilder",
          "title": "TabBuilder",
          "icon": "$(symbol-namespace)"
        }
      ]
    },
    "views": {
      "tabbuilder": [
        {
          "id": "tabbuilderView",
          "name": "Create Project",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tabbuilder.createProject",
          "when": "view == tabbuilderView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "tabbuilder.createProject",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabbuilder.createProject",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      }
    ]
  },
  "scripts": {
    "lint": "eslint src",
    "test": "node ./src/frameworks/spring-boot/generator.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0"
  }
}
